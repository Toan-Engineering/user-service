{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript"
  ],
  "env": {
    "node": true,
    "jest": true
  },
  "ignorePatterns": [
    "src/main.ts",
    "pnpm-lock.yaml",
    "dist/**",
    "node_modules/**",
    "src/models/**",
    "src/libs/database/prisma/migrations/**",
    "src/libs/database/prisma/contract.json",
    "src/libs/database/prisma/contract.d.ts",
    "src/libs/database/prisma/db.ts",
    "prisma.config.ts"
  ],
  "rules": {
    "typescript/explicit-function-return-type": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ]
  }
}